# Copy to .env for local development. Never commit .env.
# Local Postgres password for docker compose (choose any value).
POSTGRES_PASSWORD=

# Host ports (bound to 127.0.0.1 only). Change if they clash with other local services.
WEB_PORT=3100
API_PORT=8000
POSTGRES_PORT=5432
# Data pipelines (pipelines/). Runtime and cached artifacts; must be outside git or git-ignored.
JANUS_DATA_DIR=.data
# Operator contact sent in the User-Agent: an http(s) URL or an email address. Required for
# Wikidata (Wikimedia User-Agent policy). Crossref gets a mailto only if this is an email;
# otherwise it uses Crossref's public pool. Nothing is assumed when unset.
JANUS_CONTACT=
# API privacy settings (privacy spec). Donations are enabled only when region, consent
# versions and DATABASE_URL are set. Region: `local` for development, or an OCI region id in an
# EU member state (e.g. eu-frankfurt-1); chosen for production in Phase 5.
JANUS_DONATION_REGION=
# Comma-separated consent text versions the client may show (e.g. 2026-11-v1).
JANUS_CONSENT_VERSIONS=
# Event vocabulary file (CSV of the Janus vocabulary); defaults to the bundled janus/memory/memory_events.csv.
JANUS_EVENT_VOCABULARY=
# k-anonymity threshold (>= 20) and differential-privacy epsilon (0 < eps <= 10).
JANUS_K=20
JANUS_DP_EPSILON=1
# Secret key (base64url, >= 32 bytes) for deterministic noise; needed where aggregates are shown.
JANUS_NOISE_KEY=
# Doctor-note outcome loop (doctor-loop spec). Signing keys as kid:base64url pairs (each >= 32 bytes,
# never the noise key), comma-separated; the signing key id names the key for new tokens. To rotate:
# add the new key, switch the signing id, keep the old key for at least 35 days, then remove it.
# Empty keys = the outcome loop is off (the note document still works).
JANUS_NOTE_KEYS=
JANUS_NOTE_SIGNING_KEY_ID=
# Consent text versions of the outcome loop (separate from the donation consent).
JANUS_OUTCOME_CONSENT_VERSIONS=
# Optional public address of the web app (https, no trailing slash, at most 40 bytes) for the QR link.
JANUS_PUBLIC_BASE_URL=
# Tests only: a separate database, e.g. postgresql://janus:<password>@127.0.0.1:5432/janus_test
JANUS_TEST_DATABASE_URL=

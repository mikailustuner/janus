# Copy to .env for local development. Never commit .env.
# Local Postgres password for docker compose (choose any value).
POSTGRES_PASSWORD=

# Host ports (bound to 127.0.0.1 only). Change if they clash with other local services.
WEB_PORT=3100
API_PORT=8000
POSTGRES_PORT=5432
# Data pipelines (pipelines/). Runtime and cached artifacts; must be outside git or git-ignored.
JANUS_DATA_DIR=.data
# Contact address sent in the User-Agent to Crossref and Wikidata (required by their usage policies).
JANUS_CONTACT_EMAIL=

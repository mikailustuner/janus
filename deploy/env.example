# Copy to STACK_DIR/.env on the server and set mode 600. Never commit the copy.
# Settings only: secrets are files under STACK_DIR/secrets/ (never environment variables, so they
# do not show in `docker inspect`). `sudo deploy/secrets-setup.sh` creates them (postgres_password,
# database_url, noise_key, simulator_db_password, simulator_database_url) with the container users'
# ownership and mode 0440; on a new server, first put POSTGRES_PASSWORD, JANUS_NOISE_KEY and
# SIMULATOR_DB_PASSWORD in this file once, generated like this, then run the script (it moves them
# into secrets/ and removes them here):
#   POSTGRES_PASSWORD: openssl rand -base64 32 | tr -d '/+='
#   JANUS_NOISE_KEY:   openssl rand 32 | basenc --base64url | tr -d '='
#   SIMULATOR_DB_PASSWORD: openssl rand -base64 32 | tr -d '/+='
# Numeric ids of the deploy user (`id -u`, `id -g`); cloudflared reads its credentials as this user.
JANUS_UID=
JANUS_GID=
# Set by deploy.sh; do not edit.
JANUS_TAG=
# Optional; the defaults are production's (compose project, networks, subnets). Only the staging
# stack's own .env (staging-setup.sh) sets them.
# JANUS_STACK=janus-public
# JANUS_NET_INTERNAL=172.31.251.0/24
# JANUS_NET_EDGE=172.31.250.0/24

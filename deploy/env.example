# Copy to STACK_DIR/.env on the server and set mode 600. Never commit the copy.
# Generate secrets on the server, e.g.:
#   POSTGRES_PASSWORD: openssl rand -base64 32 | tr -d '/+='
#   JANUS_NOISE_KEY:   openssl rand 32 | basenc --base64url | tr -d '='
POSTGRES_PASSWORD=
JANUS_NOISE_KEY=
# Numeric ids of the deploy user (`id -u`, `id -g`); cloudflared reads its credentials as this user.
JANUS_UID=
JANUS_GID=
# Set by deploy.sh; do not edit.
JANUS_TAG=

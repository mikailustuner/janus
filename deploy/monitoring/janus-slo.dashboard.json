{
 "uid": "janus-slo",
 "title": "Janus SLO",
 "tags": [
  "janus",
  "slo"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "refresh": "5m",
 "panels": [
  {
   "type": "stat",
   "title": "Availability, 30 days (SLO 99.5 %)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "(1 - (sum(increase(janus_http_requests_total{system=\"janus\",status_class=\"5xx\"}[30d])) or vector(0)) / clamp_min(sum(increase(janus_http_requests_total{system=\"janus\"}[30d])),1)) * 100"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 3,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 99.5
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   }
  },
  {
   "type": "stat",
   "title": "Availability error budget left",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "(1 - ((sum(increase(janus_http_requests_total{system=\"janus\",status_class=\"5xx\"}[30d])) or vector(0)) / clamp_min(sum(increase(janus_http_requests_total{system=\"janus\"}[30d])),1)) / 0.005) * 100"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 25
       },
       {
        "color": "green",
        "value": 50
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   }
  },
  {
   "type": "stat",
   "title": "Requests within 500 ms, 30 days (SLO 95 %)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum(increase(janus_http_request_duration_seconds_bucket{system=\"janus\",le=\"0.5\"}[30d])) / clamp_min(sum(increase(janus_http_request_duration_seconds_count{system=\"janus\"}[30d])),1) * 100"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 95
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   }
  },
  {
   "type": "stat",
   "title": "Latency error budget left",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "(1 - (1 - sum(increase(janus_http_request_duration_seconds_bucket{system=\"janus\",le=\"0.5\"}[30d])) / clamp_min(sum(increase(janus_http_request_duration_seconds_count{system=\"janus\"}[30d])),1)) / 0.05) * 100"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "decimals": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 25
       },
       {
        "color": "green",
        "value": 50
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   }
  },
  {
   "type": "timeseries",
   "title": "Availability burn rate (1 = budget used evenly over 30 days)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "janus:error_ratio:rate1h / 0.005",
     "legendFormat": "1 h"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "janus:error_ratio:rate6h / 0.005",
     "legendFormat": "6 h"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Latency burn rate (1 = budget used evenly over 30 days)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 5,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "janus:slow_ratio:rate1h / 0.05",
     "legendFormat": "1 h"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "janus:slow_ratio:rate6h / 0.05",
     "legendFormat": "6 h"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   }
  }
 ],
 "editable": true,
 "description": "Service level objectives of the public Janus (docs/operations.md): 99.5 % of API requests without 5xx and 95 % within 500 ms over 30 days."
}
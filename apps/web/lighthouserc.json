{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:3200/en",
        "http://127.0.0.1:3200/en/about",
        "http://127.0.0.1:3200/en/privacy"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*/en$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.85,
                "aggregationMethod": "median"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.9,
                "aggregationMethod": "median"
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.9,
                "aggregationMethod": "median"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": ".*/en$",
          "assertions": {
            "categories:performance": [
              "warn",
              {
                "minScore": 0.9,
                "aggregationMethod": "median"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": ".*/en/(about|privacy)$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.9,
                "aggregationMethod": "median"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.9,
                "aggregationMethod": "median"
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.9,
                "aggregationMethod": "median"
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lighthouse"
    }
  }
}
